///|
/// Deterministic validation kernels used by sweeps, diagnostics, and examples.

///|
fn validation_kernel_001(value : Double, parameter : Double) -> Double {
  let shifted = value + parameter * 1.0e-3
  let scaled = shifted * 1.01
  let corrected = scaled - parameter / 2.0
  corrected
}

